# Куди пересилати заявки (необов'язково). Без жодного значення заявки лише логуються на сервері.
# Загальний вебхук (Make / n8n / Zapier / Google Apps Script) — отримує JSON заявки методом POST.
REGISTRATION_WEBHOOK_URL=
# Необов'язковий спільний секрет; надсилається в заголовку X-Webhook-Secret.
REGISTRATION_WEBHOOK_SECRET=
# Telegram-бот: токен від @BotFather і ID чату / каналу організаторів.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
